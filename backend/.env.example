# Application
APP_NAME=AMILE
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_STR=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://amile:password@localhost:5432/amile_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STUDENT_EVENTS=student-interactions

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# AI/ML
DKT_MODEL_PATH=ml/models/dkt/saved_model
BKT_MODEL_PATH=ml/models/bkt/saved_model
LLM_MODEL_NAME=meta-llama/Llama-3-8b-hf
OPENAI_API_KEY=optional-fallback-key

# Oracle OCI
OCI_COMPARTMENT_ID=your-compartment-id
OCI_REGION=us-ashburn-1

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@amile.io
SMTP_PASSWORD=your-smtp-password

# FERPA Encryption
ENCRYPTION_KEY=your-32-byte-fernet-key
